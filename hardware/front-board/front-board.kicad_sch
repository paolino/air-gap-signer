(text "PI_5V supplies the backlight driver." (at 223.52 124.46 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "3a9f1422-2bb7-4ae3-8aca-a16f46c9a37b"))
(text "GPIO26 BACKLIGHT_PWM controls dimming." (at 223.52 129.54 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "19c17fd4-70cd-4ca6-a703-a66d59a26bb1"))
(text "J2.33 is the LED anode. J2.34-36 are cathodes." (at 223.52 134.62 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "06d40689-32d3-42b1-9614-a9757658eb86"))
(text "Keep the cathode nets separate until the LED wiring is verified." (at 223.52 139.7 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "c27e042b-bc55-4634-90a0-82bb1ef3abc2"))
(text "The candidate drawing specifies about 120 mA total." (at 223.52 144.78 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "2614cc24-890a-4e62-80db-95a53bd4eb79"))
(text "Review the current limit and arming timing on the bench." (at 223.52 149.86 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "661e7786-741b-4ebf-b306-78bf493cbaef"))
(text "J2 flex contact side, LED driver and footprints remain open." (at 223.52 59.69 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "0ca4d542-35c6-4c2e-940d-562b8a4aea9d"))
(text "IM0, IM1 and IM2 high select four-wire SPI." (at 223.52 64.77 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "fc213f53-da37-4ecb-adaf-9ce4b37e7da1"))
(text "GPIO24 provides active-low LCD reset." (at 223.52 69.85 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "926cb494-8a20-41bc-951e-f7d85f7034a8"))
(text "U1 ties LA, LB and EP to ground. The Pi supplies I2C pull-ups." (at 26.67 181.61 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "967b6a3d-d869-4c42-91ac-e77e4369153b"))
(text "Linux inputs use pull-ups. Confirm and Mode are separate controls." (at 128.27 184.15 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "2253bf67-4cca-4407-a762-74c81e1b732d"))
